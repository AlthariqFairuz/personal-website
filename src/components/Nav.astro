---
import Icon, { type IconName } from './Icon.astro';

const items: { label: string; href: string; icon: IconName }[] = [
  { label: 'Home', href: '/', icon: 'home' },
  { label: 'Publications', href: '/publications', icon: 'book' },
  { label: 'Experience', href: '/experience', icon: 'briefcase' },
  { label: 'Awards', href: '/awards', icon: 'trophy' },
  { label: 'About', href: '/about', icon: 'user' },
];

// Highlight the link for the current page ("/publications/" → "/publications")
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav-wrap">
  <nav class="nav" aria-label="Primary">
    <ul>
      {
        items.map((item) => {
          const active = current === item.href;
          return (
            <li>
              <a
                href={item.href}
                class:list={{ active }}
                aria-label={item.label}
                aria-current={active ? 'page' : undefined}
              >
                <Icon name={item.icon} />
                <span class="label">{item.label}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
    <span class="sep" aria-hidden="true"></span>
    <button class="theme-toggle" type="button" aria-label="Toggle color theme">
      <Icon name="sun" class="sun" />
      <Icon name="moon" class="moon" />
    </button>
  </nav>
</header>

<script>
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .nav-wrap {
    position: fixed;
    top: 1rem;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 0 1rem;
    pointer-events: none;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--nav-bg);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    pointer-events: auto;
  }
  ul {
    display: flex;
    gap: 0.125rem;
  }
  a,
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 36px;
    padding: 0 0.85rem;
    border-radius: 999px;
    font-size: var(--fs-sm);
    font-weight: 500;
    line-height: 1;
    color: var(--muted);
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  a:hover,
  .theme-toggle:hover {
    color: var(--text);
  }
  a.active {
    color: var(--primary);
    background: var(--primary-soft);
  }
  .sep {
    width: 1px;
    height: 20px;
    margin: 0 0.25rem;
    background: var(--border);
  }
  .theme-toggle {
    width: 36px;
    padding: 0;
    justify-content: center;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .theme-toggle :global(.moon) {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle :global(.moon) {
    display: block;
  }
  :global([data-theme='dark']) .theme-toggle :global(.sun) {
    display: none;
  }
  @media (max-width: 760px) {
    .label {
      display: none;
    }
    a {
      width: 36px;
      padding: 0;
      justify-content: center;
    }
  }
</style>
