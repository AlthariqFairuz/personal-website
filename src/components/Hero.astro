---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { profile, publications, achievements } from '../data/cv';

// Split "[highlighted]" segments out of the intro text
const introParts = profile.intro
  .split(/(\[[^\]]+\])/)
  .filter(Boolean)
  .map((part) =>
    part.startsWith('[') ? { text: part.slice(1, -1), hl: true } : { text: part, hl: false },
  );

// Computed at build time, so it stays current with every deploy
const msPerYear = 365.25 * 24 * 60 * 60 * 1000;
const years = Math.floor((Date.now() - profile.careerStart.getTime()) / msPerYear);

const stats = [
  { value: `${publications.length}`, label: 'Publications & IP' },
  { value: `${achievements.length}`, label: 'Competition awards' },
  { value: `${years}+`, label: 'Years of experience' },
];

// Drop a photo at src/assets/profile.(jpg|png|webp) to replace the initials avatar
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/profile.{jpg,jpeg,png,webp}',
  { eager: true },
);
const photo = Object.values(photos)[0]?.default;
const initials = profile.name
  .split(' ')
  .filter((w) => /^[A-Z]/.test(w))
  .map((w) => w[0])
  .slice(-2)
  .join('');

---

<section class="hero" id="top">
  <div class="inner">
    <div class="text">
      <p class="meta reveal">
        <span class="eyebrow">{profile.role}</span>
        <span class="dot" aria-hidden="true">·</span>
        <span class="eyebrow location"><Icon name="pin" size={13} />{profile.location}</span>
      </p>
      <h1 class="reveal" style="--d: 0.08s">{profile.name}</h1>
      <p class="intro reveal" style="--d: 0.16s">
        {introParts.map((p) => (p.hl ? <span class="hl">{p.text}</span> : p.text))}
      </p>

      <dl class="stats reveal" style="--d: 0.24s">
        {
          stats.map((s) => (
            <div>
              <dt>{s.value}</dt>
              <dd>{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="photo-wrap reveal" style="--d: 0.2s">
      <div class="glow" aria-hidden="true"></div>
      {
        photo ? (
          <Image class="photo" src={photo} alt={profile.name} width={640} quality={80} loading="eager" />
        ) : (
          <div class="photo placeholder" role="img" aria-label={profile.name}>
            {initials}
          </div>
        )
      }
    </div>
  </div>

</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 7rem 1.25rem 2rem;
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 4rem;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .dot {
    color: var(--faint);
  }
  .location {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted);
  }
  h1 {
    margin-top: 1rem;
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .intro {
    margin-top: 1.25rem;
    max-width: 38rem;
    font-size: var(--fs-lg);
    line-height: var(--lh-body);
    color: var(--muted);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, max-content));
    gap: 2.5rem;
    margin-top: 2rem;
  }
  .stats dt {
    font-size: var(--fs-xl);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .stats dd {
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Photo */
  .photo-wrap {
    position: relative;
    width: 300px;
    aspect-ratio: 1;
  }
  .glow {
    position: absolute;
    inset: -30%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--glow), transparent);
    filter: blur(20px);
  }
  .photo {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Subject sits in the lower part of a portrait shot */
    object-position: 50% 82%;
    border-radius: 3rem;
    border: 1px solid var(--border);
  }
  .placeholder {
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, var(--primary-soft), var(--card));
    font-size: 5rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    color: var(--primary);
  }


  @media (max-width: 820px) {
    .hero {
      /* Keep the stats clear of the floating social dock */
      padding-bottom: 6rem;
    }
    .dot {
      display: none;
    }
    .meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
    .inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .photo-wrap {
      order: -1;
      justify-self: center;
      /* Scales with the screen: 160px on small phones, up to 240px on tablets */
      width: clamp(160px, 50vw, 240px);
    }
    .photo {
      border-radius: 2rem;
    }
    .placeholder {
      font-size: 3rem;
    }
    .stats {
      gap: 1.5rem;
    }
  }
</style>
