---
import Icon, { type IconName } from './Icon.astro';
import { socials } from '../data/cv';

const icons: Record<string, IconName> = {
  GitHub: 'github',
  LinkedIn: 'linkedin',
  Email: 'mail',
};
---

<nav class="dock" aria-label="Social links">
  <ul>
    {
      socials.map((s) => {
        const external = s.href.startsWith('http');
        return (
          <li>
            <a
              href={s.href}
              aria-label={s.label}
              title={s.label}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener' : undefined}
            >
              <Icon name={icons[s.label] ?? 'arrow'} size={18} />
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .dock {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    z-index: 50;
    transform: translateX(-50%);
    padding: 0.375rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--card) 92%, transparent);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.18);
    animation: dock-in 0.6s 0.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  ul {
    display: flex;
    gap: 0.25rem;
  }
  a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    color: var(--muted);
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }
  a:hover {
    color: var(--primary);
    background: var(--primary-soft);
    transform: translateY(-2px);
  }
  @keyframes dock-in {
    from {
      opacity: 0;
      transform: translate(-50%, 16px);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dock {
      animation: none;
    }
  }
</style>
